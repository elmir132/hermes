BOT_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
ALLOWED_USER_ID=your_telegram_user_id_here
HONCHO_API_KEY=your_honcho_api_key_here
TODOIST_TOKEN=your_todoist_api_token_here
PANDASCORE_TOKEN=your_pandascore_token_here

# Opt-in job-alert email records. Set only after validating real sender/templates.
HERMES_JOB_ALERT_RECORDS=0
# Comma-separated exact From addresses, never whole domains.
HERMES_JOB_ALERT_SENDERS=
# Optional local account labels (for example personal); empty uses working accounts.
HERMES_JOB_ALERT_ACCOUNTS=
# Independent mailbox poll; bounded to 60-3600 seconds. Does not rescan careers sites.
HERMES_JOB_ALERT_INTERVAL_SECONDS=300
